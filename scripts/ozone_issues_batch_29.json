  "HDDS-13281": {
    "jira_id": "HDDS-13281",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Disable Ratis metadata write to Raft Log on OM & SCM",
    "description": "For OM & SCM we don't have to write the commit index to the Raft Log, this is meant for scenarios where we want to recover commit index on majority failure. This is not required for OM & SCM.\r\n\r\nDisabling commit index write to Raft Log will improver the performance of Ratis as we will make one less disk IO for each transaction.",
    "commits": [
      {
        "sha": "f1470a44024194a7dd12e305ddf76fda23fd5123",
        "message": "Remove the usage of commit index from OMPrepareRequest",
