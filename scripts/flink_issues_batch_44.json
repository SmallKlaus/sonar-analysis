  "FLINK-30713": {
    "jira_id": "FLINK-30713",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Add Hadoop related k8s decorators exclude possibility",
    "description": "Hadoop related k8s decorators are making a lot of assumptions. There are some users who mount Hadoop specific things (like Hadoop config, Kerberos config/keytab) in a custom way and not depending on Flink. As a result of these assumptions the actual decorators making the workload fail and there is no workaround.",
