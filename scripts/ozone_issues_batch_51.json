  "HDDS-13831": {
    "jira_id": "HDDS-13831",
    "issue_type": "Improvement",
    "resolution": "Implemented",
    "title": "Refine getRole logic in getServiceList",
    "description": "Currently the OM processing the getServiceList() request is set to be the \"Leader\" because all requests will be forwarded to the leader.\r\n\r\nBut after supporting read from follower, this logic will show incorrect role information.\r\n\r\nThis ticket is to refine the logic, so that it will show the correct role after supporting follower-read.",
