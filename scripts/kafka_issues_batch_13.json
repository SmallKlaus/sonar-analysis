  "KAFKA-17534": {
    "jira_id": "KAFKA-17534",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Allow disabling hearbeats topic replication in MirrorSourceConnector",
    "description": "Currently, MirrorSourceConnector always replicates the heartbeats topics. In some use-cases (e.g. multiple parallel, mutually exclusive MirrorSourceConnector instances in the same replication), users need to disable this behavior.\r\n\r\nAdd a new property to allow disabling the heartbeats replication.\r\n\r\nThis ticket implements KIP-1089.",
