  "HDFS-16091": {
    "jira_id": "HDFS-16091",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "WebHDFS should support getSnapshotDiffReportListing",
    "description": "When there are millions of diffs between two snapshots, the old getSnapshotDiffReport() isn't scalable.",
