  "FLINK-12141": {
    "jira_id": "FLINK-12141",
    "issue_type": "New Feature",
    "resolution": "Fixed",
    "title": "Allow @TypeInfo annotation on POJO field declarations",
    "description": "The TypeInfo annotation is a great way to declare serializers for custom types however I feel that it's usage is limited by the fact that it can only be used on types that are declared in the project.\r\n\r\nBy allowing the annotation to be used on field declarations we could improve the TypeExtractor logic to use the type factory when creating the PojoTypeInformation.\r\n\r\nThis would be a big improvement as in many cases classes from other libraries or collection types are used within custom Pojo classes and Flink would default to Kryo serialization which would hurt performance and cause problems later.\r\n\r\nThe current workaround in these cases is to implement a custom serializer for the entire pojo which is a waste of effort when only a few fields might require custom serialization logic.",
    "commits": [
      {
        "sha": "d62971e3a4d3e1c5991fb4a20f8eb53dcd263176",
        "message": "[FLINK-12141] [API/Type Serialization System] Allow @TypeInfo annotation on POJO field declarations",
        "author": "yangfei5",
        "date": "2019-05-05T09:57:51Z",
        "files": [
          {
            "PARENT_PATH": "flink-core/src/main/java/org/apache/flink/api/common/typeinfo/TypeInfo.java",
            "CHILD_PATH": "flink-core/src/main/java/org/apache/flink/api/common/typeinfo/TypeInfo.java",
            "PATH_CHANGED": false,
            "LINES_ADDED": 1,
            "LINES_DELETED": 1,
            "PARENT_LOC": 44,
            "STATUS": "M"
          },
          {
            "PARENT_PATH": "flink-core/src/main/java/org/apache/flink/api/java/typeutils/TypeExtractor.java",
            "CHILD_PATH": "flink-core/src/main/java/org/apache/flink/api/java/typeutils/TypeExtractor.java",
            "PATH_CHANGED": false,
            "LINES_ADDED": 35,
            "LINES_DELETED": 0,
            "PARENT_LOC": 2350,
            "STATUS": "M"
          },
