  "HDDS-4189": {
    "jira_id": "HDDS-4189",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Use a unified Cli syntax for both getting OM and SCM status",
    "description": "https://github.com/apache/hadoop-ozone/pull/1346#discussion_r481380452 suggests a unification for OM and SCM for getting status by Cli.\r\n\r\nhttps://github.com/apache/hadoop-ozone/pull/1346 updated for SCM case.\r\n\r\nThis JIRA proposes to change \r\n\r\nozone admin om getserviceroles\r\nto \r\nozone admin om roles ",
    "commits": [
      {
        "sha": "a03bd2c73de079d55a0b472b1254ff3a3d7e6481",
        "message": "HDDS-4189. Change `ozone admin om getserviceroles` to `ozone admin om status`",
        "author": "amaliujia",
        "date": "2020-09-01T23:06:22Z",
        "files": [
