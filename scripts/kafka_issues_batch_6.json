  "KAFKA-9539": {
    "jira_id": "KAFKA-9539",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Add leader epoch in StopReplicaRequest",
    "description": "Unlike the LeaderAndIsrRequest, the StopReplicaRequest does not include the leader epoch which makes it vulnerable to reordering. This KIP proposes to add the leader epoch for each partition in the StopReplicaRequest and the broker will verify the epoch before proceeding with the StopReplicaRequest.",
