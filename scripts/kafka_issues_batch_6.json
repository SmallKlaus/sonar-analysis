  "KAFKA-9919": {
    "jira_id": "KAFKA-9919",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Add logging to KafkaBasedLog",
    "description": "The logging emitted on startup is a little thin, especially in the case where a worker is having trouble reading to the end of its offset, status, or config topic. We should add some {{TRACE}} and possibly {{DEBUG}} level logs to the {{KafkaBasedLog}} class so that it's clearer when this is happening.",
