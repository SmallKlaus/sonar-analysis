  "HDFS-16964": {
    "jira_id": "HDFS-16964",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Improve processing of excess redundancy after failover",
    "description": "After failover, the block with excess redundancy cannot be processed until all replicas are not stale, because the stale ones may have been deleted. That is to say, we need to wait for the FBRs of all datanodes on which the block resides before deleting the redundant replicas. This is unnecessary, we can bypass stale replicas when dealing with excess replicas, and delete non-stale excess replicas in a more timely manner.",
