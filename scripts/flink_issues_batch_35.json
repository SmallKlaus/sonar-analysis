  "FLINK-25206": {
    "jira_id": "FLINK-25206",
    "issue_type": "New Feature",
    "resolution": "Fixed",
    "title": "Add config option to disable configurations in the user program",
    "description": "If you run a large number of Flink jobs usually there is a governing entity controlling and ensuring the execution of all clusters.\r\n\r\nTo ease the control over configurations we want to enable setting a configuration that disallows configurations in the user program. \r\n\r\nBy default, this is turned off so the normal execution will not be affected.",
