  "flink": {
    "name": "Apache Flink",
    "repository": "apache/flink",
    "build_system": "maven",
    "requires_bundle": false,
    "bundle_url": "https://github.com/SmallKlaus/sonar-analysis/releases/download/td-commits-v1/flink-td-commits.bundle",
    "sonar_exclusions": [
      "**/archetype-resources/**",
      "**/flink-mesos/**",
      "**/flink-quickstart/**",
      "**/flink-runtime-web/**"
    ],
    "maven_skip_flags": [
      "-Dskip.npm",
      "-Dskip.yarn"
    ],
    "additional_maven_repos": [
      {
        "id": "mapr-public",
        "url": "https://repository.mapr.com/nexus/content/groups/mapr-public/"
      },
      {
        "id": "huaweicloudsdk",
        "url": "https://repo.huaweicloud.com/repository/maven/huaweicloudsdk/"
      }
    ]
  },
  "kafka": {
    "name": "Apache Kafka",
    "repository": "apache/kafka",
    "build_system": "gradle",
    "requires_bundle": false,
    "sonar_exclusions": [
      "**/test/**",
      "**/generated/**"
    ],
    "gradle_tasks": [
      "clean",
      "assemble"
    ],
    "use_existing_gradle_wrapper": true,
    "force_java_version": "17",
    "gradle_skip_flags": [
      "-x", "test",
      "-x", "checkstyleMain",
      "-x", "checkstyleTest"
    ]
  },
