{
  "ozone": {
    "name": "Apache Ozone",
    "repository": "apache/ozone",
    "build_system": "maven",
    "requires_bundle": false,
    "sonar_exclusions": [
      "**/archetype-resources/**"
    ],
    "maven_skip_flags": [
      "-DskipTests",
      "-Dskip.npm",
      "-Dskip.yarn"
    ],
    "patch_antrun_tasks_to_target": true,
    "additional_maven_repos": [
      {
        "id": "mapr-public",
        "url": "https://repository.mapr.com/nexus/content/groups/mapr-public/"
      },
      {
        "id": "huaweicloudsdk",
        "url": "https://repo.huaweicloud.com/repository/maven/huaweicloudsdk/"
      },
      {
        "id": "apache-snapshots",
        "url": "https://repository.apache.org/content/repositories/snapshots/",
        "snapshots": "true",
        "releases": "false"
      },
      {
        "id": "apache-group-snapshots",
        "url": "https://repository.apache.org/content/groups/snapshots/",
        "snapshots": "true",
        "releases": "false"
      }
    ]
  },
