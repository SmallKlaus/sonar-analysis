  "FLINK-21883": {
    "jira_id": "FLINK-21883",
    "issue_type": "Improvement",
    "resolution": "Fixed",
    "title": "Introduce cooldown period into adaptive scheduler",
    "description": "This is a follow up to reactive mode, introduced in FLINK-10407.\r\n\r\nIntroduce a cooldown timeout, during which no further scaling actions are performed, after a scaling action.\r\nWithout such a cooldown timeout, it can happen with unfortunate timing, that we are rescaling the job very frequently, because TaskManagers are not all connecting at the same time.\r\nWith the current implementation (1.13), this only applies to scaling up, but this can also apply to scaling down with autoscaling support.\r\n\r\nWith this implemented, users can define a cooldown timeout of say 5 minutes: If taskmanagers are now slowly connecting one after another, we will only rescale every 5 minutes.",
    "commits": [
      {
        "sha": "1ab64befd23446d45b3584b7e00c6afe88678cca",
        "message": "[FLINK-21883][scheduler] Implement cooldown period for adaptive scheduler",
        "author": "echauchot",
        "date": "2023-06-30T16:29:55Z",
